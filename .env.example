# Copy this file to .env and fill in real values.
# .env itself is gitignored on purpose — never commit real secrets.
# In development, config/settings/dev.py loads .env automatically and
# falls back to safe defaults (console email backend, SQLite) for
# anything left unset — so .env is only needed if you want real SMTP.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=verinews.com,www.verinews.com

DB_NAME=verinews
DB_USER=verinews_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- Email (Gmail SMTP) ------------------------------------------------------
# Leave EMAIL_BACKEND unset to keep using the console backend (emails
# print to the terminal). Set it to the SMTP backend below to send real
# email via Gmail. EMAIL_HOST_PASSWORD must be a 16-character Gmail
# App Password, NOT your normal Gmail login password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-char-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com
